# Puerto donde escucha el servidor (Render lo define solo)
PORT=3000

# Cadena de conexión a MongoDB
# Local:  mongodb://localhost:27017/node_chat
# Atlas:  mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/node_chat?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/node_chat

# Orígenes permitidos para CORS, separados por coma (* = cualquiera)
# Ej: http://localhost:5173,https://mi-chat.vercel.app
CORS_ORIGIN=http://localhost:5173
